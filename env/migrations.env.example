# CI/local CLI deployment credentials; NEVER static-build or app variables.
# Copy to .env.migrations (gitignored). Configure GitHub environment secrets instead for CI.
SUPABASE_ACCESS_TOKEN=REPLACE_WITH_PERSONAL_OR_AUTOMATION_TOKEN
SUPABASE_PROJECT_ID=REPLACE_WITH_TARGET_PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_WITH_TARGET_DATABASE_PASSWORD
# Production and staging have DIFFERENT values in GitHub Environments.
