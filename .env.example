# Public static-build configuration only. These values WILL be downloadable.
# cp .env.example .env ; python tools/project.py site
# The builder reads only the keys in this file; never store admin credentials here.
OPENFUEL_PUBLIC_ENV=development
OPENFUEL_PUBLIC_API_BASE_URL=/api/v1
OPENFUEL_PUBLIC_SOURCE_URL=/downloads/openfuel-source.zip
# A built static site does NOT read its host's environment after deployment.
# Changing these values requires a fresh site build.
# Optional donation page (HTTPS) for the database and map costs. Without it no donate
# button or "please donate" message appears.
# OPENFUEL_PUBLIC_DONATE_URL=
