{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenFuel live Canadian station API",
    "version": "0.4.0",
    "description": "OpenStreetMap station discovery and unverified community reports. Regional monthly Statistics Canada averages are reference context, never station pump prices. Prices use integer thousandths of CAD per litre."
  },
  "servers": [
    {
      "url": "https://openfuel.ca/api/v1"
    },
    {
      "url": "http://localhost:8787/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check live station database",
        "responses": {
          "200": {
            "description": "Live service and imported station count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/CloudflareLimit"
          },
          "503": {
            "description": "The database is unavailable (temporarily_unavailable), or OpenFuel's daily database limit is reached (spending_cap with scope all, until resets_at; Retry-After gives the seconds left)",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SpendingCap"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/stations": {
      "get": {
        "summary": "Nearby real Canadian stations; missing pump prices are null",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 100,
              "maximum": 50000,
              "default": 10000
            }
          },
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "regular",
                "premium",
                "diesel"
              ],
              "default": "regular"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stations sorted by distance, source attribution, coverage and separate dated regional monthly average. Recognized stations include nullable brandKey, brandLogoUrl and brandLogoSourceUrl from a curated external-logo catalog; clients fetch images directly and use initials on failure.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid location/query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/CloudflareLimit"
          },
          "503": {
            "description": "The database is unavailable (temporarily_unavailable), or OpenFuel's daily database limit is reached (spending_cap with scope all, until resets_at; Retry-After gives the seconds left). Over the limit, a search still answers 200 when the Worker instance or its data centre already holds prices for every area it needs, each price with its age.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SpendingCap"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/geocode": {
      "get": {
        "summary": "Search GeoNames Canadian cities with population over 15,000",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 8 matching city centres and attribution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid city query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/CloudflareLimit"
          }
        }
      }
    },
    "/regions": {
      "get": {
        "summary": "Imported Canadian coverage and provenance",
        "responses": {
          "200": {
            "description": "Country metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/CloudflareLimit"
          }
        }
      }
    },
    "/reports": {
      "post": {
        "summary": "Submit a public, unverified community pump observation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "station_id",
                  "fuel_type",
                  "price_milli",
                  "client_id"
                ],
                "properties": {
                  "station_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,64}$"
                  },
                  "fuel_type": {
                    "type": "string",
                    "enum": [
                      "regular",
                      "premium",
                      "diesel"
                    ]
                  },
                  "price_milli": {
                    "type": "integer",
                    "minimum": 500,
                    "maximum": 3999,
                    "description": "Thousandths of CAD/L: 1429 means 142.9 cents/L"
                  },
                  "client_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{16,80}$",
                    "description": "Random installation ID, not an authenticated identity; never returned publicly"
                  },
                  "request_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{16,80}$",
                    "description": "Reuse for an identical retry; use a fresh ID for a new observation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Observation persisted; verification is unverified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "200": {
            "description": "Identical retry already persisted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown imported station",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "description": "Request ID already used with different data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 2048 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Too many reports: rate_limited from the Worker (a per-IP limit of 20 a minute with Retry-After 60, or 30 an hour per client_id with Retry-After 3600), or report_capacity when the report archive is full; browsing continues. Cloudflare can also answer 429 itself (CloudflareError): error 1027 is the daily request limit until the next midnight UTC, error 1015 is not.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/CloudflareError"
                    }
                  ]
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudflareError"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable (temporarily_unavailable), or OpenFuel's daily database limit is reached (spending_cap with scope all or reports, until resets_at; Retry-After gives the seconds left)",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SpendingCap"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "not": {
              "const": "spending_cap"
            },
            "description": "Error code, such as invalid_report, rate_limited or temporarily_unavailable"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SpendingCap": {
        "type": "object",
        "description": "OpenFuel's daily database limit (HTTP 503): its own D1 budget, kept below Cloudflare's Workers Free limits, or Cloudflare's D1 daily limit. It lasts until midnight UTC.",
        "required": [
          "error",
          "reason",
          "scope",
          "resets_at",
          "message",
          "donate_url"
        ],
        "properties": {
          "error": {
            "const": "spending_cap"
          },
          "reason": {
            "type": "string",
            "description": "The specific limit, such as daily_database_budget, daily_report_budget or d1_free_daily_read_limit; clients should act on scope"
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "reports"
            ],
            "description": "all pauses database reads; reports pauses new reports only, and browsing continues"
          },
          "resets_at": {
            "type": "string",
            "format": "date-time",
            "description": "The next midnight UTC"
          },
          "message": {
            "type": "string"
          },
          "donate_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "The operator's donate link, or null"
          }
        }
      },
      "CloudflareError": {
        "type": "object",
        "description": "Cloudflare's own error, sent instead of a Worker answer: RFC 9457 problem details when the request accepts application/json or application/problem+json, an HTML page otherwise. Cloudflare adds further members such as error_category, retryable, retry_after and ray_id.",
        "required": [
          "status",
          "error_code",
          "cloudflare_error"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "error_code": {
            "type": "integer",
            "description": "1027 (error_name workers_daily_limit) is the daily Workers request limit, until the next midnight UTC. Other codes, such as 1015 (rate_limited, a Cloudflare rate limiting rule), are not the daily limit."
          },
          "error_name": {
            "type": "string"
          },
          "cloudflare_error": {
            "const": true
          }
        }
      }
    },
    "headers": {
      "Retry-After": {
        "description": "Seconds to wait before retrying",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "responses": {
      "CloudflareLimit": {
        "description": "Cloudflare's own limit, answered without the Worker. Error 1027 (workers_daily_limit): the daily Workers request limit is reached, and every API request fails until the next midnight UTC; no Retry-After is sent. Error 1015 (rate_limited) comes from a Cloudflare rate limiting rule, sends Retry-After, and is not the daily limit.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CloudflareError"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/CloudflareError"
            }
          },
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
