{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenFuel live Canadian station API",
    "version": "0.4.0",
    "description": "OpenStreetMap station discovery and unverified community reports. Regional monthly Statistics Canada averages are reference context, never station pump prices. Prices use integer thousandths of CAD per litre."
  },
  "servers": [
    {
      "url": "https://openfuel.ca/api/v1"
    },
    {
      "url": "http://localhost:8787/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check live station database",
        "responses": {
          "200": {
            "description": "Live service and imported station count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/stations": {
      "get": {
        "summary": "Nearby real Canadian stations; missing pump prices are null",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 100,
              "maximum": 50000,
              "default": 10000
            }
          },
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "regular",
                "premium",
                "diesel"
              ],
              "default": "regular"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stations sorted by distance, source attribution, coverage and separate dated regional monthly average. Recognized stations include nullable brandKey, brandLogoUrl and brandLogoSourceUrl from a curated external-logo catalog; clients fetch images directly and use initials on failure.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid location/query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/geocode": {
      "get": {
        "summary": "Search GeoNames Canadian cities with population over 15,000",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 8 matching city centres and attribution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid city query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/regions": {
      "get": {
        "summary": "Imported Canadian coverage and provenance",
        "responses": {
          "200": {
            "description": "Country metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "post": {
        "summary": "Submit a public, unverified community pump observation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "station_id",
                  "fuel_type",
                  "price_milli",
                  "client_id"
                ],
                "properties": {
                  "station_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,64}$"
                  },
                  "fuel_type": {
                    "type": "string",
                    "enum": [
                      "regular",
                      "premium",
                      "diesel"
                    ]
                  },
                  "price_milli": {
                    "type": "integer",
                    "minimum": 500,
                    "maximum": 3999,
                    "description": "Thousandths of CAD/L: 1429 means 142.9 cents/L"
                  },
                  "client_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{16,80}$",
                    "description": "Random installation ID, not an authenticated identity; never returned publicly"
                  },
                  "request_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{16,80}$",
                    "description": "Reuse for an identical retry; use a fresh ID for a new observation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Observation persisted; verification is unverified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "200": {
            "description": "Identical retry already persisted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown imported station",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "description": "Request ID already used with different data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 2048 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Report rate or capacity limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
